        "name": "2. Metingen van Python via Mosquitto naar het dashboard",
        "info": "",
        "x": 250,
        "y": 140,
        "wires": []
    },
    {
        "id": "mqtt_in_temp",
        "type": "mqtt in",
        "z": "tab_sensor",
        "name": "sensor/temperature",
        "topic": "sensor/temperature",
        "qos": "0",
        "datatype": "auto-detect",
        "broker": "broker_mosquitto",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 150,
        "y": 200,
        "wires": [["fn_parse"]]
    },
    {
        "id": "inj_fake",
        "type": "inject",
        "z": "tab_sensor",
        "name": "Testwaarde (zonder broker)",
        "props": [
            { "p": "payload" },
            { "p": "topic", "vt": "str" }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "sensor/temperature",
        "payload": "$round(18 + $random() * 8, 1)",
        "payloadType": "jsonata",
        "x": 180,
        "y": 260,
        "wires": [["fn_parse"]]
    },
    {
        "id": "fn_parse",
        "type": "function",
        "z": "tab_sensor",
        "name": "Naar getal",
        "func": "// Aanvaardt een getal, een string \"21.4\" of JSON {\"temperature\": 21.4} / {\"value\": 21.4}\nlet p = msg.payload;\nif (p !== null && typeof p === 'object') {\n    p = p.temperature ?? p.temp ?? p.value;\n}\nconst t = Number(p);\nif (!Number.isFinite(t)) {\n    node.warn('Ongeldige meting: ' + JSON.stringify(msg.payload));\n    return null;\n}\nmsg.payload = Math.round(t * 10) / 10;\nmsg.topic = 'Temperatuur';\nnode.status({ fill: 'green', shape: 'dot', text: msg.payload + ' °C' });\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 230,
        "wires": [["ui_gauge_temp", "ui_chart_temp", "ui_text_temp", "dbg_temp"]]
    },
    {
        "id": "dbg_temp",
        "type": "debug",
        "z": "tab_sensor",
        "name": "Meting",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 650,
        "y": 320,
        "wires": []
    },
